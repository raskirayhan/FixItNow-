# Backend Environment Variables
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/fixitnow?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
STRIPE_SECRET_KEY="sk_test_replace-with-your-key"
STRIPE_WEBHOOK_SECRET="whsec_replace-with-your-secret"
# Comma-separated list of allowed frontend origins. On Render, set to the frontend hostname.
FRONTEND_URL="http://localhost:5173"
PORT=5000
SEED_ADMIN_EMAIL="admin@example.invalid"
SEED_PASSWORD="replace-with-a-local-only-seed-password"
